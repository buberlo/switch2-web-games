+// UI font/logo art is immutable after UiInitialize. Cache its opaque spans,
+// bounded to 512 distinct frame/clip combinations, rather than testing a mask
+// for every pixel on every rendered frame.
+EM_JS(void, api_copy_masked_art_rows, (int src, int dst, int width, int height,
+                                     int srcStride, int dstStride, int mask), {
+  var profiler = self.DApi.profiler;
+  var clock = self.performance && self.performance.now ? function () { return self.performance.now(); } : Date.now;
+  var started = profiler ? clock() : 0;
+  var cache = self.DApi.__maskedArtCache;
+  if (!cache) cache = self.DApi.__maskedArtCache = {entries:{}, count:0};
+  var key = src + ":" + width + ":" + height + ":" + srcStride + ":" + dstStride + ":" + mask;
+  var runs = cache.entries[key];
+  if (!runs) {
+    var values = [], source = src;
+    for (var row = 0; row < height; row++) {
+      var end = source + width, left = source;
+      while (source < end) {
+        while (source < end && HEAPU8[source] === mask) source++;
+        var begin = source;
+        while (source < end && HEAPU8[source] !== mask) source++;
+        if (source > begin) values.push(begin, row * dstStride + begin - left, source - begin);
+      }
+      source += srcStride - width;
+    }
+    runs = new Int32Array(values);
+    if (cache.count >= 512) cache = self.DApi.__maskedArtCache = {entries:{}, count:0};
+    cache.entries[key] = runs;
+    cache.count++;
+  }
+  for (var i = 0; i < runs.length; i += 3) {
+    var begin = runs[i];
+    HEAPU8.set(HEAPU8.subarray(begin, begin + runs[i + 2]), dst + runs[i + 1]);
+  }
+  if (profiler) profiler("artMasked", clock() - started);
 });
 #endif
 
