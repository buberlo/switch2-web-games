+#ifdef SWITCH_FAST_BLIT
+// PALETTEENTRY is four packed bytes: red, green, blue, flags. Preserve RGB and
+// force alpha to 255 with one 32-bit store, using the current palette per blit.
+EM_JS(void, api_expand_palette, (int src, int dst, int width, int height,
+                               int srcSkip, int dstSkip, int palette), {
+  var pixels = HEAPU32;
+  var indexed = HEAPU8;
+  var target = dst >>> 2;
+  var paletteBase = palette >>> 2;
+  var targetSkip = dstSkip >>> 2;
+  for (var row = 0; row < height; row++) {
+    var end = src + width;
+    while (src < end) {
+      pixels[target++] = pixels[paletteBase + indexed[src++]] | 0xff000000;
+    }
+    src += srcSkip;
+    target += targetSkip;
+  }
+});
+#endif
