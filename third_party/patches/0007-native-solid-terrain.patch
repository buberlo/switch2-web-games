+    // spans are equivalent to native copies; translated, masked and dark rows
+    // retain the original renderer below.
+#if defined(SWITCH_FAST_DUNGEON_TERRAIN)
+    if (mask == &SolidMask[31] && tbl == NULL && light_table_index != lightmax) {
+#else
     if (leveltype == DTYPE_TOWN && light_table_index == 0 && !cel_transparency_active) {
+#endif
         BYTE *clipLow = &gpBuffer[(zoomflag ? 160 : 143) * BUFFER_WIDTH];
         BYTE *clipHigh = &gpBuffer[(zoomflag ? 512 : 320) * BUFFER_WIDTH];
-        if (api_draw_town_tile((int)dst, (int)src, tile, (int)clipLow, (int)clipHigh))
+        if (api_draw_solid_tile((int)dst, (int)src, tile, (int)clipLow, (int)clipHigh))
             return;
     }
 #endif
