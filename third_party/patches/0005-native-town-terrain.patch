+// Cache only integer source offsets and span lengths, never a heap view.
+// FreeGameMem and LoadLvlGFX invalidate source identity even if malloc later
+// reuses the same address. Cap both entry count and owned span-buffer bytes.
+EM_JS(int, api_draw_town_tile, (int dst, int src, int tile, int clipLow, int clipHigh), {
+    var cache = Module['switchTerrainCache'];
+    if (!cache) cache = Module['switchTerrainCache'] = {entries: Object.create(null), count: 0, bytes: 0};
+    var key = src + ':' + tile;
+    var spans = cache.entries[key];
+    if (!spans) {
+        if (tile < 0 || tile > 5) return 0;
+        var list = [], source = 0, row = 0, inset = 0, length = 0;
+        if (tile === 1) {
+            for (row = 0; row < 32; row++) {
+                var col = 0;
+                while (col < 32) {
+                    var code = HEAP8[src + source++];
+                    if (code === 0 || col + Math.abs(code) > 32) return 0;
+                    if (code > 0) {
+                        list.push(-row * 768 + col, source, code);
+                        source += code;
+                    }
+                    col += Math.abs(code);
+                }
+            }
+        } else {
+            var rows = tile === 2 || tile === 3 ? 31 : 32;
+            for (row = 0; row < rows; row++) {
+                inset = tile === 0 || row >= 16 && tile >= 4 ? 0 :
+                    row < 16 ? 30 - row * 2 : (row - 15) * 2;
+                length = 32 - inset;
+                if (tile === 2 || tile === 4) source += inset & 2;
+                list.push(-row * 768 + (tile === 2 || tile === 4 ? inset : 0), source, length);
+                source += length;
+                if (tile === 3 || tile === 5) source += inset & 2;
+            }
+        }
+        spans = new Int32Array(list);
+        if (cache.count >= 2048 || cache.bytes + spans.byteLength > 2097152) {
+            cache.entries = Object.create(null); cache.count = 0; cache.bytes = 0;
+        }
+        cache.entries[key] = spans; cache.count++; cache.bytes += spans.byteLength;
+    }
+    for (var i = 0; i < spans.length; i += 3) {
+        var out = dst + spans[i];
+        if (out < clipLow || out > clipHigh) continue;
+        var begin = src + spans[i + 1];
+        HEAPU8.set(HEAPU8.subarray(begin, begin + spans[i + 2]), out);
+    }
+    return 1;
+});
