+// Preserve the original upper stop / lower skip clipping at each diamond row.
+EM_JS(void, api_town_clear_diamond, (int dst, int end, int lower), {
+    for (var row = 0; row < 31; row++, dst -= 768) {
+        if (!lower && dst < end) return;
+        if (!lower || dst < end) {
+            var inset = row < 16 ? 30 - row * 2 : (row - 15) * 2;
+            HEAPU8.fill(0, dst + inset, dst + 64 - inset);
+        }
+    }
+});
+#endif
